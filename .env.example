# Environment variables for Pathway Activity Inference
# Copy to .env and set real values. Never commit .env with secrets.
# Backend is fail-closed: scoring endpoints work without gate, curated endpoints require gate.

# --- Release gate (backend/release_gate.py: MODEL_RELEASE_APPROVED / APPROVED_ARTIFACT_REVISION) ---
# Gate is fail-closed by default. Curated artifact endpoints (/api/v1/curated/* etc.) return 403 unless both are set.
# Scoring endpoints (/api/v1/score/*) remain available without gate (documented design).
MODEL_RELEASE_APPROVED=false  # set to "true" to enable curated artifact endpoints (requires revision below)
APPROVED_ARTIFACT_REVISION=  # e.g. v1.0.0-abc123 or git SHA; must be non-empty when MODEL_RELEASE_APPROVED=true

# --- Firebase auth (backend/auth.py: FIREBASE_SERVICE_ACCOUNT_JSON / FIREBASE_AUTH_DISABLED) ---
FIREBASE_SERVICE_ACCOUNT_JSON=  # path to Firebase service account JSON file, e.g. ./secrets/firebase-service-account.json (optional; if absent, token falls back to JWT structure check or 401)
FIREBASE_AUTH_DISABLED=false  # set to "true" to bypass Firebase token verification for local dev only (explicit opt-in)

# --- Frontend (frontend/src/api/client.ts uses VITE_API_URL) ---
VITE_API_URL=  # base URL for backend API, e.g. http://localhost:8000 or "" to use Vite proxy (/api -> :8000). Leave empty for local dev with proxy.
